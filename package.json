{
  "name": "ledgerlighthouse",
  "private": true,
  "description": "Confidential agentic payments: an AI agent pays for APIs over x402 while the spending policy is enforced by confidential computation on Inco.",
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test",
    "check:boundary": "node scripts/check-boundary.mjs",
    "sync:abi": "node scripts/sync-abi.mjs",
    "verify": "node scripts/verify.mjs",
    "forge:build": "pnpm --filter @ntux402/contracts run compile",
    "forge:test": "pnpm --filter @ntux402/contracts run forge:test",
    "dev": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@inco/lightning": "^1.0.2"
  }
}
