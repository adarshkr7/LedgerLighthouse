node_modules/
dist/
build/
pitch/
*.tsbuildinfo

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/*/31337/
!contracts/broadcast/*/84532/

# env — .env.example IS committed deliberately (see README.md).
# The negation must come last: in gitignore, later rules win.
.env
.env.*
!.env.example

# signer key material — never committed, ever.
# Both spellings: .env.example defaults SIGNER_KEY_STORE_PATH to `.keys/`, and an
# earlier rule only covered `keys/`. A dot's difference was enough to leave real
# payer private keys stageable, so match the leading-dot form anywhere too.
services/signer/keys/
services/signer/.keys/
.keys/
*.key
*.pem
# Keystore/wallet JSON, scoped by name. NOT a blanket *.json — that silently
# swallows every package.json and tsconfig.json in the workspace and leaves CI
# unable to find any project at all.
*keystore*.json
*.keystore

# Submission working directory — everything here is transient and safe to delete
# wholesale before the final commit. It also holds identity documents for the
# Student Group category, which must never reach the repository, so this rule
# has to exist BEFORE those files are created rather than after.
submission/

# The paper, all of it: manuscript, figures, evaluation code and data. Ignored on main for now;
# the version the paper cites is fixed by the tag `arxiv-v3`, which still contains paper/arxiv-v3
# and paper/eval. Ignored, not merely untracked, so `git clean -fd` leaves it alone.
paper/


# Execution traces are run records: prompts, vendor relationships, amounts. They
# are meant to be handed to an auditor deliberately, not committed by accident.
# Scoped by name — a blanket *.json would swallow every package.json here.
trace.json
*.trace.json

# editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json

# vite dev-server cache
apps/web/.vite/

# Durable trace store written by the orchestrator (TRACE_STORE_PATH).
.traces/

# ROFL build output. Reproducible from `oasis rofl build`; 84 MB, and the
# enclave identity it commits to is recorded in rofl.yaml, which IS tracked.
*.orc

# Machine log dumps pulled with `oasis rofl machine logs` for diagnosis.
rofl.log
rofl*.utf8.log

# The built submission PDF. Regenerated from `submission/` above, which is
# itself ignored — a 4.5 MB binary rebuilt on demand does not belong in git
# history, and it is the one artifact of that pipeline that was reaching the
# repository anyway.
LedgerLighthouse_Submission.pdf

# Old demo recordings. The recorder that made them is gone, and a single take
# is tens of megabytes, so a local copy must never reach the repository.
recordings/

# Local working notes stay out; the run records are the artifact's evidence and are tracked.
docs/*
!docs/ARCHITECTURE.md
!docs/lighthouse.webp
!docs/runs/
!docs/eval/
!docs/BENCHMARKS.md
docs/runs/*.partial.jsonl
contracts/invariant-out/
