node_modules/
dist/
build/
pitch/
*.tsbuildinfo

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/*/31337/
!contracts/broadcast/*/84532/

# env — .env.example IS committed deliberately (IMPLEMENTATION.md §9).
# The negation must come last: in gitignore, later rules win.
.env
.env.*
!.env.example

# signer key material — never committed, ever.
# Both spellings: .env.example defaults SIGNER_KEY_STORE_PATH to `.keys/`, and an
# earlier rule only covered `keys/`. A dot's difference was enough to leave real
# payer private keys stageable, so match the leading-dot form anywhere too.
services/signer/keys/
services/signer/.keys/
.keys/
*.key
*.pem
# Keystore/wallet JSON, scoped by name. NOT a blanket *.json — that silently
# swallows every package.json and tsconfig.json in the workspace and leaves CI
# unable to find any project at all.
*keystore*.json
*.keystore

# Submission working directory — everything here is transient and safe to delete
# wholesale before the final commit. It also holds identity documents for the
# Student Group category, which must never reach the repository, so this rule
# has to exist BEFORE those files are created rather than after.
submission/


# Execution traces are run records: prompts, vendor relationships, amounts. They
# are meant to be handed to an auditor deliberately, not committed by accident.
# Scoped by name — a blanket *.json would swallow every package.json here.
trace.json
*.trace.json

# editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json

# vite dev-server cache
apps/web/.vite/

# Durable trace store written by the orchestrator (TRACE_STORE_PATH).
.traces/

# The vendor spend ledger: two numbers, no secret, but a run record all the
# same. Persisted so restarting the service is not a way past the hourly
# ceiling — see services/vendor-aisa/src/upstream.ts.
.vendor-aisa/
