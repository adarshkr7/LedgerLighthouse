# Copy to .env and fill in. Never commit the real file.

CHAIN_ID=84532                # assert this before every write; never infer it from the wallet
# Accepts a comma-separated list. More than one endpoint builds a viem
# fallback transport, so a degraded public RPC fails over instead of failing.
BASE_SEPOLIA_RPC_URL=
POLICY_VAULT_ADDRESS=
TRACE_ANCHOR_ADDRESS=         # Set it and every completed trace's Merkle root is committed on
                              # chain, which is what proves *when* a trace said what it says —
                              # the hash chain alone proves only that it is internally consistent.
                              # Deploy with:
                              #   forge script script/DeployTraceAnchor.s.sol:DeployTraceAnchor \
                              #     --rpc-url "$BASE_SEPOLIA_RPC_URL" --broadcast --verify
                              # Blank disables anchoring; nothing else changes.
BASESCAN_API_KEY=             # contract verification only
INCO_NETWORK=baseSepoliaTestnet   # Lightning.baseSepoliaTestnet() network selector — see item 6
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# --- x402 -------------------------------------------------------------------
X402_VERSION=1                # PINNED to v1: X-PAYMENT / X-PAYMENT-RESPONSE, network as a slug
X402_FACILITATOR_URL=http://127.0.0.1:8403
                              # Register item 10, resolved by self-hosting: services/facilitator
                              # speaks the version we pinned. Leave BLANK for stub mode — the mock
                              # API then validates payloads but moves no money, and says so.

# --- service ports ----------------------------------------------------------
SIGNER_PORT=8402
ORCHESTRATOR_PORT=8404
FACILITATOR_PORT=8403
MOCK_API_PORT=4021

# --- keys -------------------------------------------------------------------
# Four keys, and which component may hold which is the security design, not a
# deployment detail. See README.md.
DEPLOYER_PRIVATE_KEY=         # M2b only: deploys PolicyVault and drives the measurement run.
                              # Use a throwaway testnet key. Needs ~0.003 Base Sepolia ETH.
SIGNER_KEY_STORE_PATH=.keys/payers.json
                              # Where the per-goal ephemeral payer keys live. Never a key inline.
                              # Leave blank for in-memory (keys lost on restart).
                              # Ignored when SIGNER_ROFL_SOCKET is set.
SIGNER_ROFL_SOCKET=           # Set ONLY inside a deployed ROFL container, to /run/rofl-appd.sock.
                              # Payer keys are then derived inside the TEE and no private key is
                              # ever written to disk. Absent on a laptop, so leave this blank
                              # locally — the file store above takes over.
SIGNER_ROFL_INDEX_PATH=       # Companion to the above: address -> key_id map. Non-secret.
ORCHESTRATOR_RELAY_KEY=       # gas only — requestSpend/finalize submission, not payment authorization
FACILITATOR_PRIVATE_KEY=      # gas only — submits transferWithAuthorization. Holds no user funds.
                              # Outside our trust boundary: in production someone else runs this.

RECORD_WALLET_KEY=            # Tooling only, not part of the design above: plays the user for
                              # `pnpm record:demo`, which drives the console through a scripted
                              # EIP-1193 provider instead of MetaMask. The key stays in the Node
                              # process and only signatures cross into the page. Needs the test
                              # USDC it funds plus a little gas. Falls back to DEPLOYER_PRIVATE_KEY;
                              # `--goal <id>` needs no wallet at all.

# --- LLM --------------------------------------------------------------------
# The agent speaks the OpenAI-compatible `chat/completions` shape to a gateway.
# Both of the first two must be set for a live model; leave either blank and the
# scripted agent runs instead, reproducing injection compliance offline.
AISA_INFERENCE_KEY=           # Gateway key, INFERENCE ONLY. Held by the orchestrator — which is
                              # the *untrusted* component, so a key that can also buy data APIs
                              # is a spending path that bypasses the vault entirely. See
                              # README.md.
LLM_MODEL=                    # Gateway model id. NO DEFAULT — take a live id from the gateway's
                              # own catalog. A guessed id fails as a mid-run 404, not a boot error.
AISA_API_BASE_URL=https://api.aisa.one

# --- live search vendor (services/vendor-aisa) ------------------------------
# The x402 resource server that resells AIsa search. It holds the ONLY key that
# may reach the paid data APIs, and `scripts/check-boundary.mjs` fails CI if the
# orchestrator so much as names it. Deliberately no fallback to the inference
# key: two names exist so two components hold two credentials.
AISA_VENDOR_KEY=              # A SECOND key from console.aisa.one -> API Keys, not the inference
                              # one. Give it a spend cap; that is what bounds the damage if this
                              # service is reached by something that should not have reached it.
                              # Never set this in the orchestrator's environment.
VENDOR_AISA_PORT=4022
VENDOR_AISA_PAYEE=            # Where real USDC lands. Your own MetaMask address is the right
                              # answer: nothing sweeps this one, so an address you do not hold the
                              # key for is USDC you cannot get back. Using your wallet also makes
                              # the demo net-zero -- the money leaves the payer and returns to you,
                              # and the only real cost is gas plus AIsa credits.
VENDOR_AISA_PUBLIC_URL=       # advertised base for the `resource` field; defaults to the bound port
VENDOR_AISA_LEDGER_PATH=      # where the spend ledger persists; defaults to .vendor-aisa/ledger.json.
                              # Persisted because an in-memory ceiling makes restarting the cheapest
                              # way past it, and a crash loop does that by itself. Two numbers, no secret.
VENDOR_AISA_SPEND_CAP_ATOMIC=1000000
                              # Hourly ceiling in USDC atomic units, which are also micros USD --
                              # the unit AIsa reports cost in. 1000000 = $1.00/hour. No balance
                              # endpoint exists, so this local ledger is the only spend control.

# --- operational hardening -------------------------------------------------
# Interface to bind. Loopback by default: the services hold gas keys and payer
# keys, and none of them should be reachable from the network unless someone
# deliberately says so. Set 0.0.0.0 only behind a proxy you control.
BIND_HOST=127.0.0.1

# Extra browser origins allowed to call the services. localhost is always
# permitted, so this is only needed for a deployed UI.
# CORS_ORIGINS=https://demo.example.com

# When set, every mutating route requires `Authorization: Bearer <token>`.
# Leave unset for local work. A token shipped to a browser is not a secret --
# this is a shield against untargeted scanning, not an authorisation model.
# SERVICE_TOKEN=

# Trust `x-forwarded-for` for rate-limit identity. Only behind a proxy that
# sets it, or a caller can spoof their way around the limiter.
# TRUST_PROXY=true

# --- the signer's enclave rate limit ----------------------------------------
# A second, global limiter, under the per-IP one above and specific to the TEE.
# It bounds calls into `rofl-appd`, the enclave key daemon: one derivation per
# minted payer, and one more per signature, since payer keys are re-derived
# rather than cached.
#
# It exists because per-IP limiting cannot work on the deployed ROFL machine.
# The signer is published through the Oasis proxy, so every caller arrives from
# the same source address and lands in one bucket; TRUST_PROXY=true only swaps
# that for buckets keyed on a header the caller writes. Neither bounds the
# daemon. This does, whatever route or hop the request came through.
#
# Both default generously — a run mints once per goal and derives once per paid
# call, so a real session sits far below them. Raise them for a load test; a
# non-integer or non-positive value is a startup error rather than a silent
# "unlimited". Tripping either is a 429 with `retry-after`, which the
# orchestrator retries instead of abandoning the spend.
# SIGNER_ENCLAVE_MINT_PER_MIN=30
# SIGNER_ENCLAVE_DERIVE_PER_MIN=240

# Where completed traces are written. They survive restarts; the directory is
# gitignored.
TRACE_STORE_PATH=.traces

# pretty (default) or json. Level: debug | info | warn | error.
LOG_FORMAT=pretty
LOG_LEVEL=info

# --- browser RPC ------------------------------------------------------------
# What the console uses; the services read BASE_SEPOLIA_RPC_URL. Two variables
# because only VITE_-prefixed ones reach the browser bundle — which is also what
# keeps the private keys above out of it.
#
# Same comma-separated form, and more than one entry builds a viem fallback.
# This exists because the browser previously used the chain's *default* public
# endpoint while every service used the configured list: `sepolia.base.org`
# answers some methods and returns `-32011 no backend is currently healthy` for
# `eth_call`, so the console failed on a contract read while the backend was fine.
VITE_RPC_URL=https://base-sepolia-rpc.publicnode.com,https://sepolia.base.org

# Refuse to start the signer without a ROFL enclave. The fallback stores hold
# private keys in the process or on disk; this makes that impossible to enable
# by accident.
# SIGNER_REQUIRE_ROFL=true

# --- talking to a signer that runs somewhere else ----------------------------
# Both blank on a laptop: the orchestrator then falls back to
# http://127.0.0.1:SIGNER_PORT and the local signer answers without a token.
#
# Set them together once the signer is deployed to ROFL. Setting SIGNER_URL
# alone gets 401 on every mint, because a signer with a SERVICE_TOKEN secret
# provisioned logs `token required` and rejects unauthenticated callers.
#
# **These two decide whether the enclave is actually in the loop.** With them
# blank the console still works and still mints payers — from the local file
# store, with the private key on disk. Nothing on screen distinguishes that
# from the enclave path, which is exactly why it is worth stating here: a
# screenshot of a run proves nothing about where the key came from unless
# SIGNER_URL points at the machine.
SIGNER_URL=                   # e.g. https://p8402.m<id>.<cluster>.rofl.app
                              # `oasis rofl machine show` prints it under `Proxy:`,
                              # derived from the ports in compose.yaml.
SIGNER_SERVICE_TOKEN=         # The SAME plaintext you encrypted as the signer's
                              # ROFL secret named SERVICE_TOKEN. No ROFL secret can
                              # reach back out, so this half is copied by hand.
                              #
                              # NOT `SERVICE_TOKEN` — that one guards *this* service's
                              # own routes (see above), and setting it here would make
                              # the console's own /runs and /payer calls 401, because
                              # the browser has no token to send. Falls back to
                              # SERVICE_TOKEN when unset, for a mesh where every
                              # service shares one and a gateway fronts the UI.
